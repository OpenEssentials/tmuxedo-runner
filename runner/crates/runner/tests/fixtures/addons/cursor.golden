== argv.sh 600
set -- '--plugin-dir' '<scope>/cursor-addons' "$@"
== cursor-addons/ 700
== cursor-addons/.cursor-plugin/ 700
== cursor-addons/.cursor-plugin/plugin.json 600
{
  "description": "Generated by tmuxedo-runner: the hooks of the add-ons turned on for this session.",
  "hooks": "hooks/hooks.json",
  "name": "tmuxedo-addons",
  "version": "1.0.0"
}
== cursor-addons/hooks/ 700
== cursor-addons/hooks/hooks.json 600
{
  "hooks": {
    "sessionStart": [
      {
        "command": "'<scope>/files/telemetry/bin/hook' start"
      }
    ]
  },
  "version": 1
}
== files/ 700
== files/telemetry/ 700
== files/telemetry/README.txt 600
Installed by tmuxedo.
== files/telemetry/bin/ 700
== files/telemetry/bin/hook 700
#!/bin/sh
echo "$1" >>"${EXAMPLE_TELEMETRY_LOG:-/dev/null}"
== files/telemetry/bin/statusline 700
#!/bin/sh
cat >/dev/null
echo telemetry
== report.json 600
{
  "items": [
    {
      "kind": "addon",
      "name": "telemetry",
      "sendsTo": [
        "https://telemetry.example.com"
      ],
      "status": "built"
    }
  ],
  "plugin": "cursor",
  "v": 1
}
