== addon-env.json 600
{
  "env": {
    "EXAMPLE_TELEMETRY_TOKEN": "EXAMPLE_TELEMETRY_TOKEN"
  },
  "plugin": "claude",
  "v": 1
}
== argv.sh 600
EXAMPLE_TELEMETRY_ENDPOINT='https://telemetry.example.com/v1'; export EXAMPLE_TELEMETRY_ENDPOINT
EXAMPLE_TELEMETRY_README='<scope>/files/telemetry/README.txt'; export EXAMPLE_TELEMETRY_README
eval "$('/opt/tmuxedo/tmuxedo-runner' cli secret addon-env '<scope>/addon-env.json' 2>/dev/null)"
tmuxedo_hook_settings='<scope>/claude-settings.json'
set -- "$@"
== claude-settings.json 600
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'/opt/tmuxedo/tmuxedo-runner' hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "'<scope>/files/telemetry/bin/hook' start",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'<scope>/files/telemetry/bin/hook' stop",
            "type": "command"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "command": "'<scope>/statusline.sh'",
    "type": "command"
  }
}
== files/ 700
== files/telemetry/ 700
== files/telemetry/README.txt 600
Installed by tmuxedo.
== files/telemetry/bin/ 700
== files/telemetry/bin/hook 700
#!/bin/sh
echo "$1" >>"${EXAMPLE_TELEMETRY_LOG:-/dev/null}"
== files/telemetry/bin/statusline 700
#!/bin/sh
cat >/dev/null
echo telemetry
== report.json 600
{
  "items": [
    {
      "kind": "addon",
      "name": "telemetry",
      "sendsTo": [
        "https://telemetry.example.com"
      ],
      "status": "built"
    }
  ],
  "plugin": "claude",
  "v": 1
}
== statusline.sh 700
#!/bin/sh
# tmuxedo: the add-ons' status lines, then the person's own (through
# tmuxedo's, which runs it). Generated by tmuxedo-runner.
TMUXEDO_STATUSLINE_CHAIN=''\''/opt/tmuxedo/tmuxedo-runner'\'' hook --statusline'; export TMUXEDO_STATUSLINE_CHAIN
tmuxedo_in=$(cat)
tmuxedo_addon=$(printf '%s\n' "$tmuxedo_in" | { '<scope>/files/telemetry/bin/statusline'
} 2>/dev/null)
tmuxedo_user=$(printf '%s\n' "$tmuxedo_in" | /bin/sh -c "$TMUXEDO_STATUSLINE_CHAIN" 2>/dev/null)
if [ -n "$tmuxedo_user" ]; then
  printf '%s\n' "$tmuxedo_user"
elif [ -n "$tmuxedo_addon" ]; then
  printf '%s\n' "$tmuxedo_addon"
fi
