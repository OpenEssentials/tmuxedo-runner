# syntax=docker/dockerfile:1
#
# tmuxedo runner: test, cross-build, and the downloads image, in one file.
# Build context is the REPO ROOT (the codec test reads
# packages/protocol/fixtures/data-frames.json):
#
#   docker build -f runner/Dockerfile.downloads --target test .
#   docker build -f runner/Dockerfile.downloads --build-arg TMUXEDO_VERSION=main-r000001-abc1234 -t dl .
#
# Why a Dockerfile and not `docker run -v $PWD`: on CI runners that are
# themselves containers, a bind mount of the workspace resolves on the docker
# host and comes up empty. `docker build` ships a real context.
#
# Stages:
#   toolchain  Rust 1.96.1 (+clippy, rustfmt), musl + Apple targets, zig, cargo-zigbuild
#   test       cargo fmt --check, clippy -D warnings, cargo test (real PTYs, sockets)
#   build      four release binaries (tmuxedo-runner-<key>, plus aimux-runner-<key>
#              symlinks for pre-rename installers and links) + install.sh + manifest.json in /dist
#   (final)    nginx-unprivileged on 8080 serving /dl/
#
# Apple targets link against zig's bundled libSystem stubs; nothing in the
# dependency tree needs an Apple SDK framework (TLS is rustls + ring +
# webpki-roots), so no SDK and no Mac runner are needed to build them.

# Public images by default; a registry mirror can be passed with --build-arg.
ARG RUST_IMAGE=docker.io/library/rust:1.96.1-bookworm
ARG NGINX_IMAGE=docker.io/nginxinc/nginx-unprivileged:1.27-alpine

FROM ${RUST_IMAGE} AS toolchain
ARG ZIG_VERSION=0.15.2
ARG ZIGBUILD_VERSION=0.23.4
RUN rustup component add clippy rustfmt \
 && rustup target add \
      x86_64-unknown-linux-musl aarch64-unknown-linux-musl \
      x86_64-apple-darwin aarch64-apple-darwin
RUN set -eux; \
    arch="$(uname -m)"; \
    curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-${arch}-linux-${ZIG_VERSION}.tar.xz" \
      | tar -xJ -C /opt; \
    ln -s "/opt/zig-${arch}-linux-${ZIG_VERSION}/zig" /usr/local/bin/zig; \
    curl -fsSL "https://github.com/rust-cross/cargo-zigbuild/releases/download/v${ZIGBUILD_VERSION}/cargo-zigbuild-${arch}-unknown-linux-gnu.tar.xz" \
      | tar -xJ -C /usr/local/cargo/bin --strip-components=1 "cargo-zigbuild-${arch}-unknown-linux-gnu/cargo-zigbuild"; \
    zig version; cargo-zigbuild --version

FROM toolchain AS src
COPY packages/protocol/fixtures /w/packages/protocol/fixtures
COPY runner /w/runner
WORKDIR /w/runner

FROM src AS test
ENV CARGO_TERM_COLOR=never
# sshd: the ssh-agent tests log in to a throwaway server (tests/ssh_agent.rs). Here, not in
# the toolchain stage, so the toolchain layer stays cached (rebuilding it filled the CI disk).
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server \
 && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=tmuxedo-cargo-registry \
    --mount=type=cache,target=/w/runner/target,id=tmuxedo-runner-target-test \
    cargo fmt --all --check \
 && cargo clippy --locked --workspace --all-targets -- -D warnings \
 && cargo test --locked --workspace \
 && touch /tested

# Line and branch coverage of crates/detect, gated at 100 % (scripts/detect-coverage.sh).
# As a normal user: one platform test needs a directory it cannot list, which root always can.
FROM src AS coverage
ARG COVERAGE_TOOLCHAIN=nightly-2026-10-01
ARG LLVM_COV_VERSION=0.9.1
ENV CARGO_TERM_COLOR=never
RUN rustup toolchain install "$COVERAGE_TOOLCHAIN" --profile minimal --component llvm-tools-preview \
 && cargo install cargo-llvm-cov --version "$LLVM_COV_VERSION" --locked \
 && useradd -m -u 1000 cov && chown -R cov /w/runner
USER cov
ENV CARGO_HOME=/home/cov/.cargo PATH=/usr/local/cargo/bin:$PATH DETECT_COVERAGE_TOOLCHAIN=${COVERAGE_TOOLCHAIN}
RUN --mount=type=cache,target=/home/cov/.cargo/registry,id=tmuxedo-cargo-registry-cov,uid=1000 \
    --mount=type=cache,target=/w/runner/target,id=tmuxedo-runner-target-cov,uid=1000 \
    sh scripts/detect-coverage.sh \
 && cp target/detect-coverage.json /home/cov/detect-coverage.json

FROM src AS build
ARG TMUXEDO_VERSION=dev
ENV TMUXEDO_VERSION=${TMUXEDO_VERSION} CARGO_TERM_COLOR=never
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=tmuxedo-cargo-registry \
    --mount=type=cache,target=/w/runner/target,id=tmuxedo-runner-target-release \
    set -eu; mkdir -p /dist; \
    for pair in x86_64-unknown-linux-musl:linux-x86_64 aarch64-unknown-linux-musl:linux-aarch64 \
                x86_64-apple-darwin:darwin-x86_64 aarch64-apple-darwin:darwin-aarch64; do \
      target="${pair%%:*}"; key="${pair##*:}"; \
      cargo zigbuild --locked --release -p tmuxedo-runner --target "$target"; \
      cp "target/$target/release/tmuxedo-runner" "/dist/tmuxedo-runner-$key"; \
      ln -s "tmuxedo-runner-$key" "/dist/aimux-runner-$key"; \
    done; \
    cp install.sh /dist/install.sh; \
    { printf '{\n  "version": "%s",\n  "files": {\n' "$TMUXEDO_VERSION"; \
      for key in linux-x86_64 linux-aarch64 darwin-x86_64 darwin-aarch64; do \
        sum="$(sha256sum "/dist/tmuxedo-runner-$key" | cut -d' ' -f1)"; \
        printf '    "%s": {"url": "tmuxedo-runner-%s", "sha256": "%s"},\n' "$key" "$key" "$sum"; \
      done | sed '$ s/,$//'; printf '  }\n}\n'; } > /dist/manifest.json; \
    cat /dist/manifest.json; \
    /dist/tmuxedo-runner-linux-x86_64 version 2>/dev/null || true

FROM ${NGINX_IMAGE}
ARG TMUXEDO_VERSION=dev
LABEL org.opencontainers.image.title="tmuxedo-downloads" org.opencontainers.image.version="${TMUXEDO_VERSION}"
COPY runner/nginx-downloads.conf /etc/nginx/conf.d/default.conf
COPY --from=build /dist/ /usr/share/nginx/html/dl/
EXPOSE 8080
