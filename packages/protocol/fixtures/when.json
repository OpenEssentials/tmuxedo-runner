{
  "note": "Plugin `when` conditions and `{path}` text (docs/design/plugins.md §6.1). Hand-written; checked by packages/protocol/test/when.test.ts and runner/crates/protocol/src/when.rs (tests). Change both sides or neither.",
  "ctx": {
    "auth": { "state": "expired", "reason": "login expired" },
    "agent": { "status": "blocked", "kind": "claude" },
    "machine": { "kind": "hosted", "online": true, "name": "laptop" },
    "settings": { "skill": true, "count": 3, "empty": "", "zero": 0, "nested": { "deep": "x" } },
    "plugin": { "id": "claude" }
  },
  "cases": [
    { "expr": "auth.state in ['missing','expired','failed']", "want": true },
    { "expr": "auth.state in [\"missing\", \"failed\"]", "want": false },
    { "expr": "auth.state not in ['ok']", "want": true },
    { "expr": "auth.state not in ['expired']", "want": false },
    { "expr": "auth.state in []", "want": false },
    { "expr": "agent.status == 'blocked'", "want": true },
    { "expr": "agent.status != 'blocked'", "want": false },
    { "expr": "agent.status == 'blocked' and machine.online", "want": true },
    { "expr": "agent.status == 'working' or machine.online", "want": true },
    { "expr": "agent.status == 'working' || machine.kind == 'byo'", "want": false },
    { "expr": "agent.status == 'blocked' && machine.kind == 'hosted'", "want": true },
    { "expr": "not machine.online", "want": false },
    { "expr": "!machine.online", "want": false },
    { "expr": "!(agent.kind == 'codex')", "want": true },
    { "expr": "not not machine.online", "want": true },
    { "expr": "machine.online == true", "want": true },
    { "expr": "machine.online == 'true'", "want": false },
    { "expr": "settings.count == 3", "want": true },
    { "expr": "settings.count == 3.0", "want": true },
    { "expr": "settings.count in [1, 2, 3]", "want": true },
    { "expr": "settings.count == -3", "want": false },
    { "expr": "settings.skill", "want": true },
    { "expr": "settings.empty", "want": false },
    { "expr": "settings.zero", "want": false },
    { "expr": "settings.missing", "want": false },
    { "expr": "settings.missing == null", "want": true },
    { "expr": "settings.nested", "want": false },
    { "expr": "settings.nested.deep == 'x'", "want": true },
    { "expr": "nothing.at.all == null", "want": true },
    { "expr": "auth.reason == 'login expired'", "want": true },
    { "expr": "auth.reason == \"it\\'s\"", "want": false },
    { "expr": "(agent.status == 'idle' or agent.status == 'blocked') and auth.state != 'ok'", "want": true },
    { "expr": "agent.status == 'idle' or agent.status == 'blocked' and auth.state == 'ok'", "want": false },
    { "expr": "true", "want": true },
    { "expr": "false or null", "want": false },
    { "expr": "'x'", "want": true },
    { "expr": "''", "want": false },
    { "expr": "0", "want": false },
    { "expr": "plugin.id == 'claude'", "want": true },
    { "expr": "  machine.kind  ==  'hosted'  ", "want": true }
  ],
  "empty_is_true": ["", null],
  "invalid": [
    "auth.state ==",
    "== 'x'",
    "auth.state in 'x'",
    "auth.state in [auth.state]",
    "(machine.online",
    "machine.online)",
    "Auth.state == 'x'",
    "auth.state === 'x'",
    "auth.state = 'x'",
    "'unterminated",
    "a b",
    "in",
    "machine.online and",
    "f(x)",
    "auth.state in ['a',]",
    "((((((((((((((((((true))))))))))))))))))",
    "not not not not not not not not not not not not not not not not not true"
  ],
  "too_long": 513,
  "text": [
    { "text": "Claude login needed on {machine.name}", "want": "Claude login needed on laptop" },
    { "text": "{agent.kind}: {agent.status}", "want": "claude: blocked" },
    { "text": "missing {nothing.here}!", "want": "missing !" },
    { "text": "count {settings.count} online {machine.online}", "want": "count 3 online true" },
    { "text": "{Not a placeholder} {settings.nested} {}", "want": "{Not a placeholder}  {}" },
    { "text": "no placeholders", "want": "no placeholders" }
  ]
}
